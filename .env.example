# IAF local development environment

POSTGRES_DB=iaf
POSTGRES_USER=iaf
POSTGRES_PASSWORD=iaf
# ADR-0002: PostgreSQL 16 -> 18. Host port 5432 is occupied by another
# project container, so IAF uses 5123 by default. Change via POSTGRES_PORT.
POSTGRES_PORT=5123

REDIS_PORT=6379

MINIO_ROOT_USER=iafadmin
MINIO_ROOT_PASSWORD=iafadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

BACKEND_PORT=8080
FRONTEND_PORT=3000
