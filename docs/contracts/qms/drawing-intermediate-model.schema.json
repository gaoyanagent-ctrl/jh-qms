{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jh-qms.naturedao.tech/schemas/drawing-intermediate-model/1.0.0",
  "title": "JH QMS Drawing Intermediate Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "revision", "sheets"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sheet" }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceKey"],
      "properties": { "evidenceKey": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "entity": {
      "type": "object",
      "required": ["entityId", "entityType", "sheetNo"],
      "properties": {
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceEntityHandle": { "type": ["string", "null"], "maxLength": 128 },
        "entityType": {
          "enum": ["TEXT", "MTEXT", "DIMENSION", "LEADER", "MLEADER", "BLOCK", "ATTRIBUTE", "LINE", "POLYLINE", "ARC", "CIRCLE", "SYMBOL", "TABLE", "IMAGE", "OTHER"]
        },
        "layer": { "type": ["string", "null"], "maxLength": 128 },
        "sheetNo": { "type": "string", "minLength": 1, "maxLength": 32 },
        "bbox": { "oneOf": [{ "$ref": "#/$defs/bbox" }, { "type": "null" }] },
        "geometry": { "type": ["object", "array", "null"] },
        "rawText": { "type": ["string", "null"] },
        "normalizedText": { "type": ["string", "null"] },
        "style": { "type": ["object", "null"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheetNo", "width", "height", "titleBlock", "views", "entities", "notes", "characteristicCandidates"],
      "properties": {
        "sheetNo": { "type": "string", "minLength": 1, "maxLength": 32 },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "titleBlock": { "type": "object" },
        "views": { "type": "array" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "notes": { "type": "array" },
        "characteristicCandidates": { "type": "array" }
      }
    }
  }
}
