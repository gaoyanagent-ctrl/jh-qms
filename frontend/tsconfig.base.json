{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@iaf/api-client": ["./packages/api-client/src"],
      "@iaf/auth": ["./packages/auth/src"],
      "@iaf/domain-types": ["./packages/domain-types/src"],
      "@iaf/form-engine": ["./packages/form-engine/src"],
      "@iaf/i18n": ["./packages/i18n/src"],
      "@iaf/mock-data": ["./packages/mock-data/src/register.ts"],
      "@iaf/permissions": ["./packages/permissions/src"],
      "@iaf/table-engine": ["./packages/table-engine/src"],
      "@iaf/theme": ["./packages/theme/src"],
      "@iaf/ui-business": ["./packages/ui-business/src"],
      "@iaf/ui-core": ["./packages/ui-core/src"]
    }
  }
}
